# =============================================================================
# Application
# =============================================================================

APP_NAME="Subscription API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# =============================================================================
# Logging
# =============================================================================

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# =============================================================================
# Database
# =============================================================================

# SQLite (default — zero configuration needed for local development)
DB_CONNECTION=sqlite
# DB_DATABASE=/absolute/path/to/database.sqlite

# MySQL alternative — uncomment and fill in to switch
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=subscription_db
# DB_USERNAME=root
# DB_PASSWORD=

# =============================================================================
# Session / Cache / Queue
# =============================================================================

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# =============================================================================
# Mail
# =============================================================================
# MAIL_MAILER=log writes emails to storage/logs instead of sending.
# Switch to smtp / ses / mailgun in production.

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# =============================================================================
# Subscription
# =============================================================================

# Duration of the free trial in days (config/subscription.php → trial_days)
TRIAL_DAYS=7

# =============================================================================
# Admin account (used by AdminUserSeeder — change before seeding production)
# =============================================================================

ADMIN_EXTERNAL_ID=ADMIN-001
ADMIN_NAME="System Administrator"
ADMIN_EMAIL=admin@subscription.test
# ADMIN_PASSWORD is write-only: hashed by User model on save, never exposed
ADMIN_PASSWORD=change-me-in-production

# =============================================================================
# PayPal (manual transfer)
# =============================================================================
# Set PAYPAL_RECEIVER_EMAIL to the PayPal account that receives payments.
# This email is shown to users in the payment instructions.

PAYPAL_RECEIVER_EMAIL=payments@example.com
PAYPAL_RECEIVER_NAME="Subscription Payments"

# =============================================================================
# Payment proof screenshots
# =============================================================================

# Maximum allowed screenshot size in kilobytes (default 5 MB)
PROOF_MAX_SIZE_KB=5120
# Disk defined in config/filesystems.php ('public' or 's3')
PROOF_STORAGE_DISK=public

# =============================================================================
# Renewals (attendance_token API — private proof storage)
# =============================================================================

RENEWAL_UPLOAD_DEADLINE_HOURS=48
RENEWAL_RATE_LIMIT_CHECKOUT_PER_MIN=10
RENEWAL_RATE_LIMIT_PROOF_PER_MIN=8
RENEWAL_PROOF_MAX_SIZE_KB=5120
# Disk from config/filesystems.php — use "local" for storage/app/private (default)
RENEWAL_PROOF_STORAGE_DISK=local

# =============================================================================
# CORS
# =============================================================================
# Comma-separated list of allowed origins, or * to allow all.
# Examples:
#   CORS_ALLOWED_ORIGINS=*
#   CORS_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
#
# CORS_SUPPORTS_CREDENTIALS must be false when using bearer tokens (mobile).
# Set to true only for cookie-based SPA flows (and remove * from origins).

CORS_ALLOWED_ORIGINS=*
CORS_SUPPORTS_CREDENTIALS=false
CORS_MAX_AGE=86400

# Regex patterns for wildcard subdomains (comma-separated, optional)
# CORS_ALLOWED_ORIGINS_PATTERNS=#^https://[a-z0-9-]+\.example\.com$#

# =============================================================================
# Sanctum
# =============================================================================
# Comma-separated domains that receive stateful cookie sessions (SPA use).
# Mobile apps using bearer tokens do not need to be listed here.

SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:8000
SANCTUM_TOKEN_PREFIX=

# =============================================================================
# Attendance (presensi) server — token validation, voucher redeem gate, etc.
# =============================================================================

# ATTENDANCE_SERVER_URL=http://localhost:8001
# ATTENDANCE_SERVER_TIMEOUT=30
# Session check before voucher redeem (Bearer = attendance_token)
# ATTENDANCE_SESI_AJA_PATH=/api/absen/sesi-aja
# ATTENDANCE_SESI_AJA_METHOD=GET

# =============================================================================
# Firebase Cloud Messaging (admin dashboard — push to users)
# =============================================================================
# Path to Google service account JSON (project_id, client_email, private_key).
# Disarankan: letakkan JSON di storage (tidak di bawah public/), contoh:
# FIREBASE_CREDENTIALS=storage/app/private/firebase/dev-app-41a02-firebase-adminsdk-fbsvc-e1589ea7a4.json
# Di production gunakan path absolut atau secret manager; jangan commit file JSON.
# Antrian untuk FCM setelah admin membalas pesan user (default sync = tanpa worker).
# FIREBASE_ADMIN_MESSAGE_QUEUE_CONNECTION=database
